# Copy this file to .env.local for your computer.
# On Vercel, set the same names in Project → Settings → Environment Variables.
# Never commit real values. This repository is public.

# Protects /api/cron. Vercel sends it as "Authorization: Bearer <CRON_SECRET>".
# Use at least 16 random characters. Example:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# Primary summaries. Free key: https://console.groq.com/keys
# Stay on the free plan. Model openai/gpt-oss-120b is about 8,000 tokens per minute.
GROQ_API_KEY=

# Automatic fallback if Groq fails. Free key: https://aistudio.google.com/apikey
# Model gemini-3.5-flash-lite. Do not turn on billing.
GEMINI_API_KEY=

# ntfy topic. This acts like a password: anyone who knows it can read your notifications.
# Make it long and random. Do not use a guessable name like "morning-brief".
# Example:
#   node -e "console.log('mb-' + require('crypto').randomBytes(18).toString('hex'))"
NTFY_TOPIC=

# Optional. The public ntfy server is free and works with the official iPhone and Android apps.
NTFY_SERVER=https://ntfy.sh

# Public address of the site, with no slash at the end.
# The phone notification opens https://SITE_URL/digest/YYYY-MM-DD
# Example: https://morning-brief.vercel.app
SITE_URL=

# Filled in by Vercel when you connect a Blob store. Leave blank on your computer
# and digests are saved in the .data folder instead.
BLOB_READ_WRITE_TOKEN=

# Optional. Leave unset for a private Blob store.
# Set to public only if you created the store as Public.
# BLOB_ACCESS=private

# Optional overrides if a model id changes.
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-3.5-flash-lite
